{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "Personal pi-coding-agent extensions",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/colored-footer.ts",
      "./extensions/herdr-ask-user-bridge.ts",
      "./extensions/herdr-tab-name.ts",
      "./extensions/llm-session-name.ts",
      "./extensions/plan.ts",
      "./extensions/stash.ts",
      "./extensions/update-extensions.ts",
      "./extensions/web",
      "./extensions/pi-tool-permissions",
      "./extensions/guard",
      "./extensions/wt-tab-status",
      "./extensions/external-editor-fix",
      "./extensions/idle-summary",
      "./extensions/slack-via-claude.ts",
      "./extensions/ollama-models.ts",
      "./extensions/python",
      "./extensions/node",
      "./extensions/session-search",
      "./extensions/subagent",
      "./extensions/update-jira",
      "./extensions/timestamps",
      "./extensions/git-read"
    ],
    "prompts": ["./extensions/subagent/prompts/*.md"]
  },
  "scripts": {
    "test:timestamps": "node --test tests/timestamps.test.mts",
    "test:python": "node --test tests/python-unit.test.mts tests/python-integration.test.mts",
    "test:node": "node --test tests/node-unit.test.mts tests/node-integration.test.mts",
    "test:jira": "node --test tests/update-jira-unit.test.mts tests/update-jira-tools.test.mts",
    "test:guard": "node --test tests/guard-sandbox-unit.test.mts tests/guard-sandbox-integration.test.mts && node tests/guard-policy.test.mts && node tests/guard-classes.test.mts && node tests/guard-migrate.test.mts && node tests/guard-filter.test.mts && node tests/guard-workers.test.mts && node tests/guard-runtime.test.mts && node tests/guard-harness.test.mts && node --test tests/guard-dialogs.test.mts && node --test tests/guard-ask-overlay.test.mts && node tests/guard-subagent.test.mts && node --test tests/tool-annotations.test.mts && node --test tests/guard-render-call.test.mts"
  },
  "dependencies": {
    "html-to-text": "^10.0.1"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.99.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "typebox": "*"
  }
}
