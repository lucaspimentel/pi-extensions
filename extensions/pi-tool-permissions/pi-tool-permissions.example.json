{
  "defaultAction": "ask",
  "readAllowCwd": true,
  "grepAllowCwd": true,
  "globAllowCwd": true,
  "lsAllowCwd": true,
  "readAllowSkills": true,
  "readAllowPiDocs": true,
  "bashReadOnlyAllowCwd": true,
  "toolDefaults": {
    "write": "ask",
    "mcp": "ask"
  },
  "allow": [
    "Glob",
    "Grep",
    "WebSearch",
    "Mcp(slack_*)",
    "Mcp(github_*)",
    "WebFetch(https://github.com/*)",
    "WebFetch(https://docs.*)",
    "Bash(npm test*)",
    "Bash(npm run *)",
    "Bash(npm run * > /tmp/*)",
    "Bash(git status*)",
    "Bash(git diff*)",
    "Bash(git log*)"
  ],
  "deny": [
    "Bash(rm -rf*)",
    "Bash(sudo*)",
    "Bash(/.*\\b(chmod|chown)\\b.*777.*/)",
    "Mcp(slack_slack_post_*)",
    "Write(.env*)",
    "Write(*/.git/*)",
    "Edit(.env*)"
  ],
  "ask": [
    "Bash(git push*)",
    "Bash(npm publish*)",
    "Mcp(atlassian_*)",
    "WebFetch(*)"
  ],
  "autoMode": {
    "classifier": { "provider": "anthropic", "model": "claude-haiku-4-5" },
    "environment": [
      "Trusted repo: github.com/lucaspimentel/*",
      "Trusted domains: *.internal.example.com"
    ],
    "allow":     ["Running tests and linters"],
    "soft_deny": ["Force pushing, deleting remote branches", "Creating a pull request or pushing a branch on GitHub via gh, modifying remote state"],
    "hard_deny": ["Sending data to third-party APIs or external services for telemetry, analytics, or exfiltration (not normal GitHub dev actions like opening PRs or pushing branches via gh)"],
    "classifyAllShell": true
  }
}
